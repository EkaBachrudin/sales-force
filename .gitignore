logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# TESTING & COVERAGE
# ============================================
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ============================================
# IDE & EDITORS
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# OPERATING SYSTEMS
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# DOCKER
# ============================================
# Docker volumes data
docker/data/

# ============================================
# DATABASE
# ============================================
*.sqlite
*.sqlite3
*.db

# ============================================
# MISC
# ============================================
.cache/
temp/
tmp/
*.bak
*.backup
*.pid
*.seed
*.pid.lock
.pnp.*
.turbo/

# ============================================
# SERVICE-SPECIFIC IGNORES
# ============================================

# Frontend specific
sales-force-fe-react/dist/
sales-force-fe-react/node_modules/

# Backend specific
sales-force-be/dist/
sales-force-be/build/
sales-force-be/coverage/
sales-force-be/*.tsbuildinfo

# ============================================
# NGINX & SSL (keep sample configs, ignore actual certificates)
# ============================================
docker/nginx/ssl/*.key
docker/nginx/ssl/*.crt
docker/nginx/ssl/*.pem
!docker/nginx/ssl/*.example
