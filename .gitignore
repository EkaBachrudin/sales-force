# ============================================
# ENVIRONMENT & SECRETS
# ============================================
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# DEPENDENCIES
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
