# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and .env.dev, then fill in the values

# --------------------------------------------
# General Configuration
# --------------------------------------------
NODE_ENV=production

# --------------------------------------------
# Application Ports
# --------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_PORT=5432

# --------------------------------------------
# Nginx Configuration
# --------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --------------------------------------------
# Frontend Configuration
# --------------------------------------------
VITE_API_URL=http://localhost

# Google Sheets Integration (for "Saya Tertarik!" form)
# Get this URL from Google Apps Script deployment
# See sales-force-fe-react/google-sheets-script.gs for setup instructions
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
GOOGLE_SCRIPT_ID=...

# --------------------------------------------
# Backend Configuration
# --------------------------------------------
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=24h
# CORS (comma-separated for multiple origins)
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DB_NAME=salesforce
DB_USER=postgres
DB_PASSWORD=change-this-password

# --------------------------------------------
# SSL Configuration (Optional - for production)
# --------------------------------------------
SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
SSL_KEY_PATH=./docker/nginx/ssl/key.pem

rclone_gdrive=...